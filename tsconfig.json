{
  "compilerOptions": {
    "target": "ES2021",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "baseUrl": "."
  },
  "include": [
    "src"
  ]
}
